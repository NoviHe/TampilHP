{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TampilHP",
  "version": "0.1.0",
  "identifier": "com.tampilhp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TampilHP — Android Mirror & Stream",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/scrcpy/*"
    ]
  }
}
